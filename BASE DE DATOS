-- BASE DE DATOS IMPORTADORA JJ



USE importadorajj;


CREATE TABLE usuario (
    cedula_usuario VARCHAR(10) PRIMARY KEY NOT NULL,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    telefono VARCHAR(15) NOT NULL,
    correo_electronico VARCHAR(100) NOT NULL,
    direccion VARCHAR(200) NOT NULL,
    fecha_nacimiento DATE NOT NULL,
    contrasena VARCHAR(255) NOT NULL,
    rol ENUM('ADMINISTRADOR', 'BODEGUERO', 'VENDEDOR') NOT NULL,
    estado ENUM('activo', 'inactivo') NOT NULL DEFAULT 'activo'
);



CREATE TABLE cliente (
    cedula_cliente VARCHAR(10) PRIMARY KEY NOT NULL,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    telefono VARCHAR(15) NOT NULL,
    correo_electronico VARCHAR(100) NOT NULL,
    direccion VARCHAR(200) NOT NULL,
    fecha_nacimiento DATE NOT NULL,
    estado ENUM('activo', 'inactivo') NOT NULL DEFAULT 'activo',
    fk_cedula_vendedor VARCHAR(10) NULL,
    FOREIGN KEY (fk_cedula_vendedor) REFERENCES usuario(cedula_usuario)
);


CREATE TABLE producto (
    codigo_producto VARCHAR(6) PRIMARY KEY NOT NULL,
    nombre_producto VARCHAR(150) NOT NULL,
    cantidad INT NOT NULL DEFAULT 0,
    descripcion TEXT,
    costo DECIMAL(10,2) NOT NULL,
    estado ENUM('activo', 'inactivo') NOT NULL DEFAULT 'activo'
);



CREATE TABLE factura (
    id_factura INT PRIMARY KEY AUTO_INCREMENT,
    fk_cedula_cliente VARCHAR(10) NOT NULL,
    fk_cedula_usuario VARCHAR(10) NOT NULL,
    fecha_elaboracion TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
    total DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (fk_cedula_cliente) REFERENCES cliente(cedula_cliente),
    FOREIGN KEY (fk_cedula_usuario) REFERENCES usuario(cedula_usuario)
);




CREATE TABLE detalle (
    id_detalle INT PRIMARY KEY AUTO_INCREMENT,
    fk_id_factura INT NOT NULL,
    fk_codigo_producto VARCHAR(6) NOT NULL,
    cantidad INT NOT NULL,
    valor_unitario DECIMAL(10,2) NOT NULL,
    subtotal DECIMAL(10,2) NOT NULL,
    descuento DECIMAL(10,2) DEFAULT 0.00,
    FOREIGN KEY (fk_id_factura) REFERENCES factura(id_factura),
    FOREIGN KEY (fk_codigo_producto) REFERENCES producto(codigo_producto)
);




