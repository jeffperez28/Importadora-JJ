CREACION DE UN FLUJO


Creacion de un flujo para factura 

-- PASO 1: INSERTAR FACTURA
INSERT INTO factura (fk_cedula_cliente, fk_cedula_usuario, total)
VALUES (0703558064, 1002642930, 0.00);

-- PASO 2: INSERTAR DETALLES
INSERT INTO detalle (fk_id_factura, fk_codigo_producto, cantidad, valor_unitario, subtotal)
VALUES (1, 'P00001', 2, 150.00, 0);

-- PASO 3: CALCULAR SUBTOTALES
UPDATE detalle
SET subtotal = cantidad * valor_unitario
WHERE fk_id_factura = 1;

-- PASO 4: DESCONTAR STOCK
UPDATE producto SET cantidad = cantidad - 2 WHERE codigo_producto = 'P00001';

-- PASO 5: VERIFICAR SUBTOTAL
SELECT cantidad * valor_unitario FROM detalle WHERE fk_id_factura = 1;


+---------------------------+
| cantidad * valor_unitario |
+---------------------------+
|                     50.00 |
|                     76.00 |
|                    300.00 |
+---------------------------+



-- PASO 6: CALCULAR TOTAL
SELECT SUM(subtotal) AS total_factura FROM detalle WHERE fk_id_factura = 1;


+---------------+
| total_factura |
+---------------+
|        426.00 |
+---------------+

-- PASO 7: ACTUALIZAR TOTAL EN FACTURA
UPDATE factura SET total = 485.00 WHERE id_factura = 1;

-- PASO 8: CALCULAR IVA (12%)
SELECT total * 0.12 AS iva FROM factura WHERE id_factura = 1;


+---------+
| iva     |
+---------+
| 58.2000 |
+---------+


-- PASO 9: TOTAL CON IVA
SELECT total + (total * 0.12) AS total_con_iva FROM factura WHERE id_factura = 1;


+---------------+
| total_con_iva |
+---------------+
|      543.2000 |
+---------------+


